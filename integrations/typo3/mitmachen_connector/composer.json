{
  "name": "gematik/mitmachen-connector",
  "description": "Server-side TYPO3/Powermail outbox connector for #Mitmachen registrations",
  "type": "typo3-cms-extension",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": "^8.2",
    "ext-json": "*",
    "in2code/powermail": "^13.0",
    "typo3/cms-core": "^13.4",
    "typo3/cms-extbase": "^13.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "suggest": {
    "typo3/cms-scheduler": "Run the delivery command from the TYPO3 Scheduler backend module."
  },
  "autoload": {
    "psr-4": {
      "Gematik\\MitmachenConnector\\": "Classes/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Gematik\\MitmachenConnector\\Tests\\": "Tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "typo3/cms-composer-installers": true,
      "typo3/class-alias-loader": true
    },
    "platform": {
      "php": "8.2.29"
    },
    "sort-packages": true
  },
  "extra": {
    "typo3/cms": {
      "extension-key": "mitmachen_connector"
    }
  },
  "scripts": {
    "test": "phpunit -c phpunit.xml.dist",
    "test:lint": "find . -path './vendor' -prune -o -name '*.php' -print0 | xargs -0 -n 1 php -l"
  }
}
