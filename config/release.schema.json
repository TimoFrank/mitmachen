{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "release.schema.json",
  "title": "Versorgungs-Kompass release policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "productVersion",
    "baselineVersion",
    "baselineRef",
    "defaultBump",
    "policy"
  ],
  "properties": {
    "$schema": { "const": "./release.schema.json" },
    "schemaVersion": { "const": 2 },
    "productVersion": { "$ref": "#/$defs/version" },
    "baselineVersion": { "$ref": "#/$defs/version" },
    "baselineRef": { "type": "string", "minLength": 1 },
    "defaultBump": { "const": "minor" },
    "policy": { "$ref": "#/$defs/policy" }
  },
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policyVersion",
        "effectiveFromVersion",
        "tag",
        "releaseCandidate",
        "stable",
        "cadence",
        "documentation",
        "deliveryChannels",
        "handoff",
        "legacyTags"
      ],
      "properties": {
        "policyVersion": { "const": 1 },
        "effectiveFromVersion": { "$ref": "#/$defs/version" },
        "tag": { "$ref": "#/$defs/tag" },
        "releaseCandidate": { "$ref": "#/$defs/releaseCandidate" },
        "stable": { "$ref": "#/$defs/stable" },
        "cadence": { "$ref": "#/$defs/cadence" },
        "documentation": { "$ref": "#/$defs/documentation" },
        "deliveryChannels": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/deliveryChannel" }
        },
        "handoff": { "$ref": "#/$defs/handoff" },
        "legacyTags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "tag": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "signed", "annotated", "verifyBeforePublish", "immutable"],
      "properties": {
        "format": { "const": "vX.Y.Z" },
        "signed": { "const": true },
        "annotated": { "const": true },
        "verifyBeforePublish": { "const": true },
        "immutable": { "const": true }
      }
    },
    "releaseCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "untilVersion",
        "preferredLabel",
        "allowedAlternateLabel",
        "githubPrerelease",
        "githubLatest",
        "titlePattern",
        "hotfixTitlePattern"
      ],
      "properties": {
        "untilVersion": { "const": "1.0.0" },
        "preferredLabel": { "const": "Release Candidate" },
        "allowedAlternateLabel": { "const": "Proof of Concept" },
        "githubPrerelease": { "const": true },
        "githubLatest": { "const": false },
        "titlePattern": { "type": "string", "minLength": 1 },
        "hotfixTitlePattern": { "type": "string", "minLength": 1 }
      }
    },
    "stable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "firstVersion",
        "automatic",
        "requiresExplicitAuthorization",
        "requiresDeploymentProfile",
        "requiresVerifiedDeployment",
        "tagBeforeTargetBuild",
        "githubReleaseAfterVerifiedDeployment",
        "githubPrerelease",
        "githubLatest",
        "compactDisplayWhenPatchZero",
        "titlePattern",
        "hotfixTitlePattern"
      ],
      "properties": {
        "firstVersion": { "const": "1.0.0" },
        "automatic": { "const": false },
        "requiresExplicitAuthorization": { "const": true },
        "requiresDeploymentProfile": { "const": "target" },
        "requiresVerifiedDeployment": { "const": true },
        "tagBeforeTargetBuild": { "const": true },
        "githubReleaseAfterVerifiedDeployment": { "const": true },
        "githubPrerelease": { "const": false },
        "githubLatest": { "const": true },
        "compactDisplayWhenPatchZero": { "const": true },
        "titlePattern": { "type": "string", "minLength": 1 },
        "hotfixTitlePattern": { "type": "string", "minLength": 1 }
      }
    },
    "cadence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["weekly", "hotfix"],
      "properties": {
        "weekly": {
          "type": "object",
          "additionalProperties": false,
          "required": ["weekday", "time", "timeZone", "bump", "skipWithoutChanges"],
          "properties": {
            "weekday": { "const": "friday" },
            "time": { "const": "09:17" },
            "timeZone": { "const": "Europe/Berlin" },
            "bump": { "const": "minor" },
            "skipWithoutChanges": { "const": true }
          }
        },
        "hotfix": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bump", "scheduled"],
          "properties": {
            "bump": { "const": "patch" },
            "scheduled": { "const": false }
          }
        }
      }
    },
    "documentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["weekly", "hotfix"],
      "properties": {
        "weekly": {
          "type": "object",
          "additionalProperties": false,
          "required": ["theme", "releaseNotes", "changelog", "inAppHistory"],
          "properties": {
            "theme": { "const": "required" },
            "releaseNotes": { "const": "full" },
            "changelog": { "const": "themed-release-section" },
            "inAppHistory": { "const": true }
          }
        },
        "hotfix": {
          "type": "object",
          "additionalProperties": false,
          "required": ["theme", "releaseNotes", "changelog", "inAppHistory", "carryIntoNextWeekly"],
          "properties": {
            "theme": { "const": "forbidden" },
            "releaseNotes": { "const": "compact" },
            "changelog": { "const": "compact-item-under-current-minor" },
            "inAppHistory": { "const": false },
            "carryIntoNextWeekly": { "const": true }
          }
        }
      }
    },
    "deliveryChannel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "deploymentProfile",
        "authMode",
        "buildAuthority",
        "releaseTrigger",
        "crossChannelPromotion"
      ],
      "properties": {
        "id": { "enum": ["pages-demo", "private-gke", "gematik-target"] },
        "deploymentProfile": { "enum": ["pages-demo", "pre-gematik", "target"] },
        "authMode": { "enum": ["anonymous-demo", "iap", "oidc"] },
        "buildAuthority": { "enum": ["github-actions", "github-actions-gke", "software-factory"] },
        "releaseTrigger": { "enum": ["product-release", "manual-approval", "controlled-release"] },
        "crossChannelPromotion": { "const": false }
      }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "destination", "targetBuild", "requiredProof", "forbiddenInputs"],
      "properties": {
        "source": { "const": "signed-git-tag" },
        "destination": { "const": "gitlab-software-factory" },
        "targetBuild": { "const": "fresh-from-tag" },
        "requiredProof": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": ["tag-object-sha", "commit-sha", "signer-fingerprint", "tag-signature-verification", "target-artifact-digests"]
          }
        },
        "forbiddenInputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "workspace-archive",
              "pages-artifacts",
              "private-gke-artifacts",
              "personal-values",
              "secrets",
              "data",
              "oidc-subjects"
            ]
          }
        }
      }
    }
  }
}
