# Phasenminimale, nicht aufgeloeste Beispielumgebung fuer die ausschliessliche
# Online-Neunutzeranlage. Eine aufgeloeste Kopie muss owner-only (0600),
# ausserhalb des Git-Worktrees und im bereits owner-only geschuetzten
# Run-Verzeichnis liegen.
#
# Dieses Beispiel enthaelt absichtlich kein PRE_IMPORT_BACKUP_ID: Exakt die
# Kombination create=true/reconcile=false waehlt das Online-Gate fuer
# automatische Backups und PITR. Jeder andere Modus bleibt wartungsgebunden.

GCP_PROJECT_ID=example-pre-gematik-project
GCP_REGION=europe-west3
GKE_CLUSTER_NAME=versorgungs-kompass-pre-gematik
GKE_LOCATION=europe-west3
K8S_NAMESPACE=pre-gematik
CLOUD_SQL_INSTANCE_CONNECTION_NAME=example-pre-gematik-project:europe-west3:vk-pre-gematik-postgres
PRE_GEMATIK_GCP_PROJECT_SHA256=sha256:REPLACE_WITH_INDEPENDENTLY_APPROVED_64_HEX_DIGEST
EXPECTED_TARGET_PROJECT_ID=example-pre-gematik-project
GUEST_ACCESS_CREATE_PROFILE_AND_PREBIND=true
GUEST_ACCESS_RECONCILE_PROFILE_DISPLAY_NAME_AND_PREBIND=false
