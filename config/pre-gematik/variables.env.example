# GitHub Environment variables for `pre-gematik`.
# Copy names and resolved Terraform outputs into GitHub Settings > Environments.
# This file contains no secret. Never add DB_PASSWORD or a service-account JSON key.

GCP_PROJECT_ID=example-pre-gematik-project
GCP_PROJECT_NUMBER=123456789012
GCP_REGION=europe-west3
GKE_CLUSTER_NAME=versorgungs-kompass-pre-gematik
GKE_LOCATION=europe-west3
WIF_PROVIDER=projects/123456789012/locations/global/workloadIdentityPools/github-pre-gematik/providers/github-actions
DEPLOYER_SERVICE_ACCOUNT=github-pre-gematik-deployer@example-pre-gematik-project.iam.gserviceaccount.com
GAR_REPOSITORY=europe-west3-docker.pkg.dev/example-pre-gematik-project/versorgungs-kompass-pre-gematik

# Kanonischer gemeinsamer Origin nach dem Domain-Cutover.
# Nur waehrend der Zertifikatsvorbereitung bleiben beide Werte voruebergehend
# auf https://mitmachen.timo-frank.de.
API_BASE_URL=https://versorgungs-kompass.de
FRONTEND_BASE_URL=https://versorgungs-kompass.de
FRONTEND_BUCKET=example-pre-gematik-frontend

DB_NAME=versorgungs_kompass
DB_USER=vk_app
DB_PASSWORD_SECRET_NAME=vk-pre-gematik-postgres-password
IAP_OAUTH_BOOTSTRAP_SECRET_NAME=vk-pre-gematik-iap-oauth-bootstrap

PROFILE_IMAGE_BUCKET=example-pre-gematik-profiles
CONTACT_IMAGE_BUCKET=example-pre-gematik-contacts
CONTACT_NOTE_ATTACHMENT_BUCKET=example-pre-gematik-attachments
STAKEHOLDER_LOGO_BUCKET=example-pre-gematik-stakeholder-logos
CLOUD_SQL_INSTANCE_CONNECTION_NAME=example-pre-gematik-project:europe-west3:vk-pre-gematik-postgres
GKE_INGRESS_IP_NAME=vk-pre-gematik-api
K8S_NAMESPACE=pre-gematik
IAP_OAUTH_CLIENT_CREDENTIALS_SECRET_NAME=versorgungs-kompass-iap-oauth
IAP_RESOURCE_ACCESS_PRINCIPAL=group:versorgungs-kompass-pre-gematik-access@googlegroups.com
IAP_RESOURCE_ACCESS_EXPIRES_AT=2026-09-30T16:00:00Z

# Der TYPO3-M2M-Eingang bleibt bis zum fachlichen und rechtlichen Go-live aus.
# Hier stehen nur nichtgeheime Werte und Kubernetes-Secret-Referenzen. Die
# base64-kodierten HMAC-Secrets selbst gehoeren niemals in diese Datei.
TYPO3_CONNECTOR_ENABLED=0
TYPO3_CONNECTOR_FORM_UID=41
TYPO3_CONNECTOR_SOURCE_URL=https://www.gematik.de/mitmachen/versorgungs-netzwerk
TYPO3_CONNECTOR_FORM_VERSION=
TYPO3_CONNECTOR_PRIVACY_NOTICE_VERSION=
TYPO3_CONNECTOR_CONSENT_TEXT_VERSION=
TYPO3_CONNECTOR_BODY_LIMIT_BYTES=24000
TYPO3_CONNECTOR_CLOCK_SKEW_SECONDS=300
TYPO3_CONNECTOR_KEY_ID=
TYPO3_CONNECTOR_CURRENT_SECRET_NAME=vk-pre-gematik-typo3-connector-hmac
TYPO3_CONNECTOR_CURRENT_SECRET_KEY=current-hmac-secret-base64
TYPO3_CONNECTOR_PREVIOUS_KEY_ENABLED=0
TYPO3_CONNECTOR_PREVIOUS_KEY_ID=
TYPO3_CONNECTOR_PREVIOUS_SECRET_NAME=vk-pre-gematik-typo3-connector-hmac
TYPO3_CONNECTOR_PREVIOUS_SECRET_KEY=previous-hmac-secret-base64

# Sicherer Standard und Rollback-Pfad. Der externe Modus wird erst nach dem
# kontrollierten Portal-, Provider- und Login-Nachweis aktiviert.
IAP_IDENTITY_MODE=iam
IAP_GCIP_PROJECT_ID=
IAP_GCIP_TENANT_ID=
IAP_EXTERNAL_LOGIN_PAGE_URI=
# Browser-sichtbarer, auf Identity Toolkit und Secure Token beschraenkter
# Web-API-Key. Er wird in jedem Modus fuer das gebrandete Portal gebaut; im
# externen Modus muessen beide Werte exakt identisch sein.
IDENTITY_PLATFORM_API_KEY=
IAP_EXTERNAL_AUTH_API_KEY=
IAP_EXTERNAL_ACCESS_EXPIRES_AT=
# SHA-256 der freigegebenen ENFORCE/force-upgrade-Policy mit 14..128 Zeichen
# und Pflicht fuer Klein-/Grossbuchstaben, Zahl und Sonderzeichen.
IDENTITY_PLATFORM_PASSWORD_POLICY_SHA256=
# Zeitstempel und SHA-256 eines echten, hoechstens 24 Stunden alten
# Google-Login-Nachweises ueber das eigene Portal.
IDENTITY_PLATFORM_GOOGLE_LOGIN_VERIFIED_AT=
IDENTITY_PLATFORM_GOOGLE_LOGIN_EVIDENCE_SHA256=
