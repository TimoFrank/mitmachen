# Local operator configuration for controlled pre-gematik access changes.
# Never copy these values into GitHub Environment variables and never commit a
# resolved copy. Set credentials only in a protected, short-lived shell/session.

# Read-only GCP context and concrete pre-change backup gate.
GCP_PROJECT_ID=example-pre-gematik-project
GCP_REGION=europe-west3
GKE_CLUSTER_NAME=versorgungs-kompass-pre-gematik
GKE_LOCATION=europe-west3
K8S_NAMESPACE=pre-gematik
CLOUD_SQL_INSTANCE_CONNECTION_NAME=example-pre-gematik-project:europe-west3:vk-pre-gematik-postgres
PRE_GEMATIK_GCP_PROJECT_SHA256=sha256:REPLACE_WITH_INDEPENDENTLY_APPROVED_64_HEX_DIGEST
PRE_IMPORT_BACKUP_ID=REPLACE_WITH_CONCRETE_SUCCESSFUL_PRE_CHANGE_BACKUP_ID
# Optional lower time bound for the concrete backup, in ISO-8601 format.
# PRE_IMPORT_BACKUP_NOT_BEFORE=2026-07-20T00:00:00.000Z

# Pinned official Cloud SQL Auth Proxy used and started by the Apply tools.
# Resolve symlinks and approve the binary digest independently before the run.
CLOUD_SQL_AUTH_PROXY_EXECUTABLE=/absolute/path/to/cloud-sql-proxy
CLOUD_SQL_AUTH_PROXY_SHA256=sha256:REPLACE_WITH_INDEPENDENTLY_APPROVED_64_HEX_DIGEST
# Unset means the existing local sql-data path. Only the dedicated, short-lived
# GKE access Job sets this exact value; all other values fail closed.
# CLOUD_SQL_AUTH_PROXY_CONNECT_MODE=private-ip

# Target project pin required by the Google guest-access phases.
EXPECTED_TARGET_PROJECT_ID=example-pre-gematik-project
# IAP identity-binding administration. The login is short-lived and
# must inherit exactly the NOLOGIN role vk_identity_admin; use the protected
# prepare:pre-gematik-identity-operator output instead of resolving this sample.
# The URL is a credential template only: the operator ignores the loopback port
# and creates a private Unix socket through its instance-bound Auth Proxy.
PRE_GEMATIK_IDENTITY_ADMIN_DATABASE_URL='postgresql://identity_operator:REPLACE_IN_PROTECTED_SESSION@127.0.0.1:5432/versorgungs_kompass?sslmode=disable'
PRE_GEMATIK_IDENTITY_TARGET_SHA256=sha256:REPLACE_WITH_INDEPENDENTLY_APPROVED_64_HEX_DIGEST
# Used only by the dedicated GKE access operator identity-apply phase.
CONFIRM_IDENTITY_PREVIEW_FINGERPRINT=sha256:REPLACE_WITH_IMMEDIATELY_REVIEWED_IDENTITY_PREVIEW_DIGEST
CONFIRM_IDENTITY_CURRENT_STATE_FINGERPRINT=sha256:REPLACE_WITH_CURRENT_STATE_DIGEST_FROM_THE_SAME_PREVIEW
CONFIRM_IDENTITY_BINDING_COUNT=1
CONFIRM_IDENTITY_ACTIVE_BINDING_COUNT=1
# Set both values only for a reviewed native-IAP <-> Identity-Platform
# subject-only remap. Preview and apply must use the same mode.
ALLOW_IDENTITY_SUBJECT_REMAPS=false
# Use the positive previewed count for a real remap. Exactly 0 is allowed only
# for the separately reviewed, fully unchanged post-apply readback/no-op.
# CONFIRM_IDENTITY_SUBJECT_REMAP_COUNT=1
# Password-guest prebinding through the private-IP GKE operator. Resolve the
# database values with prepare:pre-gematik-test-access-operator; do not reuse
# this sample or add unrelated credentials to the guest phase Secret.
PRE_GEMATIK_ACCESS_ADMIN_DATABASE_URL='postgresql://access_operator:REPLACE_IN_PROTECTED_SESSION@127.0.0.1:5432/versorgungs_kompass?sslmode=disable'
PRE_GEMATIK_ACCESS_TARGET_SHA256=sha256:REPLACE_WITH_INDEPENDENTLY_APPROVED_64_HEX_DIGEST
IAP_EXTERNAL_AUTH_API_KEY=REPLACE_IN_PROTECTED_SESSION
# Required in both guest-preview and guest-apply; exactly true or false.
GUEST_ACCESS_RECONCILE_PROFILE_DISPLAY_NAME_AND_PREBIND=false
# Used only by guest-apply, from the immediately reviewed guest-preview.
CONFIRM_GUEST_ACCESS_OPERATION=PREBIND_IDENTITY_PLATFORM_PASSWORD_GUEST
CONFIRM_GUEST_ACCESS_INPUT_FINGERPRINT=sha256:REPLACE_WITH_GUEST_INPUT_DIGEST
CONFIRM_GUEST_ACCESS_CURRENT_STATE_FINGERPRINT=sha256:REPLACE_WITH_GUEST_CURRENT_STATE_DIGEST
