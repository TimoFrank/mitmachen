# Aufgelöste Kopie: 0600, außerhalb des Worktrees; nur Cloud-Run-Neuanlage.
GCP_PROJECT_ID=example-project
GCP_REGION=europe-west3
EXPECTED_TARGET_PROJECT_ID=example-project
CLOUD_SQL_INSTANCE_CONNECTION_NAME=example-project:europe-west3:vk-postgres
PRE_GEMATIK_GCP_PROJECT_SHA256=sha256:REPLACE_WITH_INDEPENDENTLY_APPROVED_PROJECT_PIN
GOOGLE_APP_SERVICE=versorgungs-kompass
GOOGLE_APP_REVISION=versorgungs-kompass-REPLACE_WITH_READY_REVISION
GOOGLE_RESET_SERVICE=versorgungs-kompass-password-reset
GOOGLE_RESET_REVISION=versorgungs-kompass-password-reset-REPLACE_WITH_READY_REVISION
GOOGLE_NETWORK=vk-network
GOOGLE_SUBNET=vk-cloud-run
GOOGLE_ONBOARDING_SERVICE_ACCOUNT=vk-google-onboarding@example-project.iam.gserviceaccount.com
GOOGLE_ONBOARDING_BUCKET=example-project-vk-onboarding
GUEST_ACCESS_CREATE_PROFILE_AND_PREBIND=true
GUEST_ACCESS_RECONCILE_PROFILE_DISPLAY_NAME_AND_PREBIND=false
