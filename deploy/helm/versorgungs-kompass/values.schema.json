{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Versorgungs-Kompass Helm values",
  "type": "object",
  "required": ["image", "config", "frontend"],
  "properties": {
    "image": {
      "type": "object",
      "required": ["repository", "tag", "digest"],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "^(?:latest|stable|main|master)$"
          }
        },
        "digest": {
          "type": "string",
          "pattern": "^(|sha256:[a-f0-9]{64})$"
        }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "aliasHosts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^([A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)+[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?$"
          }
        }
      }
    },
    "config": {
      "type": "object",
      "required": ["apiAuthMode"],
      "properties": {
        "apiAuthMode": {
          "type": "string",
          "enum": ["iap", "oidc"]
        },
        "hospitationImportOwnerProfileId": {
          "type": "string",
          "pattern": "^(|[A-Za-z0-9][A-Za-z0-9._:-]{0,159})$"
        },
        "oidcIssuer": {
          "type": "string"
        },
        "oidcAudience": {
          "type": "string"
        },
        "oidcJwksUrl": {
          "type": "string"
        },
        "attachmentUploadMode": {
          "const": "disabled"
        },
        "imageUploadMode": {
          "const": "disabled"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "apiAuthMode": {
                "const": "oidc"
              }
            }
          },
          "then": {
            "required": ["oidcIssuer", "oidcAudience", "oidcJwksUrl"],
            "properties": {
              "oidcIssuer": {
                "pattern": "^https://[^\\s]+$"
              },
              "oidcAudience": {
                "minLength": 1
              },
              "oidcJwksUrl": {
                "pattern": "^https://[^\\s]+$"
              }
            }
          }
        }
      ]
    },
    "database": {
      "type": "object",
      "required": ["ssl"],
      "properties": {
        "ssl": {
          "type": "string",
          "enum": ["verify-full", "disable"]
        },
        "sslCaSecretName": {
          "type": "string"
        },
        "sslCaSecretKey": {
          "type": "string"
        },
        "sslServerName": {
          "type": "string"
        }
      }
    },
    "storage": {
      "type": "object",
      "required": [
        "profileImageBucket",
        "contactImageBucket",
        "contactNoteAttachmentBucket",
        "stakeholderLogoBucket"
      ],
      "properties": {
        "profileImageBucket": { "type": "string" },
        "contactImageBucket": { "type": "string" },
        "contactNoteAttachmentBucket": { "type": "string" },
        "stakeholderLogoBucket": { "type": "string" }
      }
    },
    "networkPolicy": {
      "type": "object",
      "required": ["enabled", "ingress"],
      "properties": {
        "enabled": {
          "const": true
        },
        "ingress": {
          "type": "object",
          "required": ["apiAllowedCidrs", "frontendAllowedCidrs"],
          "properties": {
            "apiAllowedCidrs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^[0-9a-fA-F:.]+/[0-9]{1,3}$"
              }
            },
            "frontendAllowedCidrs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^[0-9a-fA-F:.]+/[0-9]{1,3}$"
              }
            }
          }
        }
      }
    },
    "frontend": {
      "type": "object",
      "required": ["enabled", "bucketName", "releasePrefix", "contentRevision", "publicEntry"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "bucketName": {
          "type": "string"
        },
        "releasePrefix": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
        },
        "contentRevision": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$|^$"
        },
        "hostRedirects": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["host", "targetOrigin"],
            "additionalProperties": false,
            "properties": {
              "host": {
                "type": "string",
                "pattern": "^([A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)+[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?$"
              },
              "targetOrigin": {
                "type": "string",
                "pattern": "^https://([A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)+[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?$"
              }
            }
          }
        },
        "publicEntry": {
          "type": "object",
          "required": ["enabled", "replicaCount", "image", "serviceAccount", "service", "backendConfig"],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "replicaCount": {
              "type": "integer",
              "minimum": 1
            },
            "image": {
              "type": "object",
              "required": ["repository", "tag", "digest", "pullPolicy"],
              "properties": {
                "repository": {
                  "type": "string",
                  "minLength": 1
                },
                "tag": {
                  "type": "string",
                  "minLength": 1,
                  "not": {
                    "pattern": "^(?:latest|stable|main|master)$"
                  }
                },
                "digest": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                },
                "pullPolicy": {
                  "type": "string",
                  "enum": ["Always", "IfNotPresent"]
                }
              }
            },
            "serviceAccount": {
              "type": "object",
              "additionalProperties": false,
              "required": ["create", "name", "automountServiceAccountToken"],
              "properties": {
                "create": {
                  "const": true
                },
                "name": {
                  "const": "versorgungs-kompass-frontend-public"
                },
                "automountServiceAccountToken": {
                  "const": false
                }
              }
            },
            "service": {
              "type": "object",
              "required": ["port"],
              "properties": {
                "port": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                }
              }
            },
            "backendConfig": {
              "type": "object",
              "required": ["name", "timeoutSec", "healthCheck", "iap"],
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
                },
                "timeoutSec": {
                  "type": "integer",
                  "minimum": 1
                },
                "healthCheck": {
                  "type": "object",
                  "required": [
                    "requestPath",
                    "port",
                    "checkIntervalSec",
                    "timeoutSec",
                    "healthyThreshold",
                    "unhealthyThreshold"
                  ],
                  "properties": {
                    "requestPath": {
                      "const": "/_healthz"
                    },
                    "port": {
                      "const": 8080
                    },
                    "checkIntervalSec": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "timeoutSec": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "healthyThreshold": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "unhealthyThreshold": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                },
                "iap": {
                  "type": "object",
                  "required": ["enabled", "oauthClientCredentialsSecretName"],
                  "properties": {
                    "enabled": {
                      "type": "boolean"
                    },
                    "oauthClientCredentialsSecretName": {
                      "type": "string"
                    }
                  },
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "enabled": {
                            "const": true
                          }
                        },
                        "required": ["enabled"]
                      },
                      "then": {
                        "properties": {
                          "oauthClientCredentialsSecretName": {
                            "minLength": 1
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            },
            "required": ["enabled"]
          },
          "then": {
            "properties": {
              "bucketName": {
                "minLength": 1
              },
              "contentRevision": {
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "publicEntry": {
                "properties": {
                  "enabled": {
                    "const": true
                  }
                },
                "required": ["enabled"]
              }
            },
            "required": ["publicEntry"]
          },
          "then": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          }
        }
      ]
    },
    "gke": {
      "type": "object",
      "properties": {
        "managedCertificate": {
          "type": "object",
          "required": ["enabled", "name", "domains", "additionalCertificates"],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "name": {
              "type": "string",
              "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
            },
            "domains": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^([A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)+[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?$"
              }
            },
            "additionalCertificates": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "domains"],
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
                  },
                  "domains": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "pattern": "^([A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)+[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?$"
                    }
                  }
                }
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "enabled": {
                    "const": true
                  }
                },
                "required": ["enabled"]
              },
              "then": {
                "properties": {
                  "domains": {
                    "minItems": 1
                  }
                }
              }
            }
          ]
        }
      }
    }
  }
}
