{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Versorgungs-Kompass Helm values",
  "type": "object",
  "required": ["productVersion", "image", "config", "frontend", "typo3Connector", "passwordResetBroker"],
  "properties": {
    "productVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "image": {
      "type": "object",
      "required": [
        "repository",
        "tag",
        "digest"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "^(?:latest|stable|main|master)$"
          }
        },
        "digest": {
          "type": "string",
          "pattern": "^(|sha256:[a-f0-9]{64})$"
        }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "aliasHosts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^([A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)+[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?$"
          }
        }
      }
    },
    "passwordResetBroker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "replicaCount",
        "port",
        "invitationBucketName",
        "email",
        "podAnnotations",
        "serviceAccount",
        "service",
        "backendConfig",
        "resources"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "port": {
          "const": 8080
        },
        "invitationBucketName": {
          "type": "string",
          "maxLength": 63,
          "pattern": "^$|^[a-z0-9][a-z0-9-]{1,61}[a-z0-9]$"
        },
        "email": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "secretName",
            "secretKey"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "secretName": {
              "type": "string",
              "maxLength": 63,
              "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
            },
            "secretKey": {
              "type": "string",
              "maxLength": 253,
              "pattern": "^[A-Za-z0-9._-]+$"
            }
          }
        },
        "podAnnotations": {
          "type": "object",
          "maxProperties": 0,
          "additionalProperties": false
        },
        "serviceAccount": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "create",
            "name",
            "annotations",
            "automountServiceAccountToken"
          ],
          "properties": {
            "create": {
              "const": true
            },
            "name": {
              "const": "versorgungs-kompass-password-reset"
            },
            "annotations": {
              "type": "object",
              "maxProperties": 0,
              "additionalProperties": false
            },
            "automountServiceAccountToken": {
              "const": false
            }
          }
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "port",
            "annotations"
          ],
          "properties": {
            "port": {
              "const": 80
            },
            "annotations": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        "backendConfig": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "securityPolicyName",
            "timeoutSec",
            "connectionDrainingTimeoutSec",
            "healthCheck"
          ],
          "properties": {
            "name": {
              "type": "string",
              "maxLength": 63,
              "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
            },
            "securityPolicyName": {
              "type": "string",
              "maxLength": 63,
              "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
            },
            "timeoutSec": {
              "type": "integer",
              "const": 45
            },
            "connectionDrainingTimeoutSec": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3600
            },
            "healthCheck": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "requestPath",
                "port",
                "checkIntervalSec",
                "timeoutSec",
                "healthyThreshold",
                "unhealthyThreshold"
              ],
              "properties": {
                "type": {
                  "const": "HTTP"
                },
                "requestPath": {
                  "const": "/healthz"
                },
                "port": {
                  "const": 8080
                },
                "checkIntervalSec": {
                  "type": "integer",
                  "minimum": 1
                },
                "timeoutSec": {
                  "type": "integer",
                  "minimum": 1
                },
                "healthyThreshold": {
                  "type": "integer",
                  "minimum": 1
                },
                "unhealthyThreshold": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        },
        "resources": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            },
            "required": [
              "enabled"
            ]
          },
          "then": {
            "properties": {
              "invitationBucketName": {
                "minLength": 3
              },
              "email": {
                "properties": {
                  "enabled": {
                    "const": true
                  },
                  "secretName": {
                    "minLength": 1
                  },
                  "secretKey": {
                    "minLength": 1
                  }
                }
              },
              "backendConfig": {
                "properties": {
                  "securityPolicyName": {
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      ]
    },
    "typo3Connector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "formUid",
        "sourceUrl",
        "formVersion",
        "privacyNoticeVersion",
        "consentTextVersion",
        "bodyLimitBytes",
        "clockSkewSeconds",
        "currentKey",
        "previousKey",
        "service",
        "backendConfig"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "formUid": {
          "const": 41
        },
        "sourceUrl": {
          "const": "https://www.gematik.de/mitmachen/versorgungs-netzwerk"
        },
        "formVersion": {
          "type": "string",
          "maxLength": 120
        },
        "privacyNoticeVersion": {
          "type": "string",
          "maxLength": 120
        },
        "consentTextVersion": {
          "type": "string",
          "maxLength": 120
        },
        "bodyLimitBytes": {
          "const": 24000
        },
        "clockSkewSeconds": {
          "const": 300
        },
        "currentKey": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "secretName", "secretKey"],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^(|[A-Za-z0-9][A-Za-z0-9._-]{0,63})$"
            },
            "secretName": {
              "type": "string",
              "maxLength": 253,
              "pattern": "^(|[a-z0-9](?:[-.a-z0-9]*[a-z0-9])?)$"
            },
            "secretKey": {
              "type": "string",
              "maxLength": 253,
              "pattern": "^(|[A-Za-z0-9._-]+)$"
            }
          }
        },
        "previousKey": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "id", "secretName", "secretKey"],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "id": {
              "type": "string",
              "pattern": "^(|[A-Za-z0-9][A-Za-z0-9._-]{0,63})$"
            },
            "secretName": {
              "type": "string",
              "maxLength": 253,
              "pattern": "^(|[a-z0-9](?:[-.a-z0-9]*[a-z0-9])?)$"
            },
            "secretKey": {
              "type": "string",
              "maxLength": 253,
              "pattern": "^(|[A-Za-z0-9._-]+)$"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "enabled": {
                    "const": true
                  }
                },
                "required": ["enabled"]
              },
              "then": {
                "properties": {
                  "id": {
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
                  },
                  "secretName": {
                    "minLength": 1
                  },
                  "secretKey": {
                    "minLength": 1
                  }
                }
              }
            }
          ]
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "required": ["port", "annotations"],
          "properties": {
            "port": {
              "const": 80
            },
            "annotations": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        "backendConfig": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "name",
            "timeoutSec",
            "connectionDrainingTimeoutSec",
            "healthCheck"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "name": {
              "type": "string",
              "maxLength": 63,
              "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
            },
            "timeoutSec": {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400
            },
            "connectionDrainingTimeoutSec": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3600
            },
            "healthCheck": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "requestPath",
                "port",
                "checkIntervalSec",
                "timeoutSec",
                "healthyThreshold",
                "unhealthyThreshold"
              ],
              "properties": {
                "type": {
                  "const": "HTTP"
                },
                "requestPath": {
                  "const": "/api/readyz"
                },
                "port": {
                  "const": 8080
                },
                "checkIntervalSec": {
                  "type": "integer",
                  "minimum": 1
                },
                "timeoutSec": {
                  "type": "integer",
                  "minimum": 1
                },
                "healthyThreshold": {
                  "type": "integer",
                  "minimum": 1
                },
                "unhealthyThreshold": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            },
            "required": ["enabled"]
          },
          "then": {
            "properties": {
              "formVersion": {
                "pattern": "^\\S(?:.*\\S)?$"
              },
              "privacyNoticeVersion": {
                "pattern": "^\\S(?:.*\\S)?$"
              },
              "consentTextVersion": {
                "pattern": "^\\S(?:.*\\S)?$"
              },
              "currentKey": {
                "properties": {
                  "id": {
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
                  },
                  "secretName": {
                    "minLength": 1
                  },
                  "secretKey": {
                    "minLength": 1
                  }
                }
              },
              "backendConfig": {
                "properties": {
                  "enabled": {
                    "const": true
                  }
                }
              }
            }
          }
        }
      ]
    },
    "config": {
      "type": "object",
      "required": [
        "apiAuthMode"
      ],
      "properties": {
        "apiAuthMode": {
          "type": "string",
          "enum": [
            "iap",
            "oidc"
          ]
        },
        "iapIdentityMode": {
          "type": "string",
          "enum": [
            "iam",
            "external"
          ]
        },
        "iapGcipProjectId": {
          "type": "string",
          "pattern": "^(|[a-z][a-z0-9-]{4,28}[a-z0-9])$"
        },
        "iapGcipTenantId": {
          "type": "string",
          "pattern": "^$"
        },
        "iapExternalLoginPageUri": {
          "type": "string",
          "pattern": "^(|https://[a-z0-9]([a-z0-9.-]*[a-z0-9])?(/[A-Za-z0-9._~%:@+/-]*)?)$"
        },
        "iapExternalAuthApiKey": {
          "type": "string",
          "pattern": "^(|AIza[0-9A-Za-z_-]{35})$"
        },
        "iapExternalAccessExpiresAt": {
          "type": "string",
          "pattern": "^(|[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z)$"
        },
        "hospitationImportOwnerProfileId": {
          "type": "string",
          "pattern": "^(|[A-Za-z0-9][A-Za-z0-9._:-]{0,159})$"
        },
        "oidcIssuer": {
          "type": "string"
        },
        "oidcAudience": {
          "type": "string"
        },
        "oidcJwksUrl": {
          "type": "string"
        },
        "attachmentUploadMode": {
          "const": "disabled"
        },
        "imageUploadMode": {
          "const": "disabled"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "apiAuthMode": {
                "const": "oidc"
              }
            }
          },
          "then": {
            "required": [
              "oidcIssuer",
              "oidcAudience",
              "oidcJwksUrl"
            ],
            "properties": {
              "oidcIssuer": {
                "pattern": "^https://[^\\s]+$"
              },
              "oidcAudience": {
                "minLength": 1
              },
              "oidcJwksUrl": {
                "pattern": "^https://[^\\s]+$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "iapIdentityMode": {
                "const": "external"
              }
            },
            "required": [
              "iapIdentityMode"
            ]
          },
          "then": {
            "required": [
              "apiAuthMode",
              "iapGcipProjectId",
              "iapGcipTenantId",
              "iapExternalLoginPageUri",
              "iapExternalAuthApiKey",
              "iapExternalAccessExpiresAt"
            ],
            "properties": {
              "apiAuthMode": {
                "const": "iap"
              },
              "iapGcipProjectId": {
                "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]$"
              },
              "iapGcipTenantId": {
                "const": ""
              },
              "iapExternalLoginPageUri": {
                "pattern": "^https://[a-z0-9]([a-z0-9.-]*[a-z0-9])?(/[A-Za-z0-9._~%:@+/-]*)?$"
              },
              "iapExternalAuthApiKey": {
                "pattern": "^AIza[0-9A-Za-z_-]{35}$"
              },
              "iapExternalAccessExpiresAt": {
                "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
              }
            }
          }
        }
      ]
    },
    "database": {
      "type": "object",
      "required": [
        "ssl"
      ],
      "properties": {
        "ssl": {
          "type": "string",
          "enum": [
            "verify-full",
            "disable"
          ]
        },
        "sslCaSecretName": {
          "type": "string"
        },
        "sslCaSecretKey": {
          "type": "string"
        },
        "sslServerName": {
          "type": "string"
        }
      }
    },
    "storage": {
      "type": "object",
      "required": [
        "profileImageBucket",
        "contactImageBucket",
        "contactNoteAttachmentBucket",
        "stakeholderLogoBucket"
      ],
      "properties": {
        "profileImageBucket": {
          "type": "string"
        },
        "contactImageBucket": {
          "type": "string"
        },
        "contactNoteAttachmentBucket": {
          "type": "string"
        },
        "stakeholderLogoBucket": {
          "type": "string"
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "required": [
        "enabled",
        "ingress"
      ],
      "properties": {
        "enabled": {
          "const": true
        },
        "ingress": {
          "type": "object",
          "required": [
            "apiAllowedCidrs",
            "frontendAllowedCidrs",
            "passwordResetAllowedCidrs"
          ],
          "properties": {
            "apiAllowedCidrs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^[0-9a-fA-F:.]+/[0-9]{1,3}$"
              }
            },
            "frontendAllowedCidrs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^[0-9a-fA-F:.]+/[0-9]{1,3}$"
              }
            },
            "passwordResetAllowedCidrs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^[0-9a-fA-F:.]+/[0-9]{1,3}$"
              }
            }
          }
        }
      }
    },
    "frontend": {
      "type": "object",
      "required": [
        "enabled",
        "bucketName",
        "releasePrefix",
        "contentRevision",
        "publicEntry"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "bucketName": {
          "type": "string"
        },
        "releasePrefix": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
        },
        "contentRevision": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$|^$"
        },
        "hostRedirects": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "host",
              "targetOrigin"
            ],
            "additionalProperties": false,
            "properties": {
              "host": {
                "type": "string",
                "pattern": "^([A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)+[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?$"
              },
              "targetOrigin": {
                "type": "string",
                "pattern": "^https://([A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)+[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?$"
              }
            }
          }
        },
        "authProxy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "replicaCount",
            "podAnnotations",
            "image",
            "imagePullPolicy",
            "podSecurityContext",
            "securityContext",
            "serviceAccount",
            "service",
            "resources",
            "backendConfig"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "replicaCount": {
              "type": "integer",
              "minimum": 2
            },
            "podAnnotations": {
              "type": "object"
            },
            "image": {
              "const": "nginxinc/nginx-unprivileged:1.31.2-alpine3.23@sha256:6320020c7da8714feab524e02c08c5a1958675c4e68700e93a2fd8970b065786"
            },
            "imagePullPolicy": {
              "const": "IfNotPresent"
            },
            "podSecurityContext": {
              "const": {
                "runAsNonRoot": true,
                "runAsUser": 101,
                "runAsGroup": 101,
                "fsGroup": 101,
                "fsGroupChangePolicy": "OnRootMismatch",
                "seccompProfile": {
                  "type": "RuntimeDefault"
                }
              }
            },
            "securityContext": {
              "const": {
                "allowPrivilegeEscalation": false,
                "readOnlyRootFilesystem": true,
                "runAsNonRoot": true,
                "runAsUser": 101,
                "runAsGroup": 101,
                "capabilities": {
                  "drop": [
                    "ALL"
                  ]
                }
              }
            },
            "serviceAccount": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "create",
                "name",
                "automountServiceAccountToken"
              ],
              "properties": {
                "create": {
                  "const": true
                },
                "name": {
                  "const": "versorgungs-kompass-frontend-auth-proxy"
                },
                "automountServiceAccountToken": {
                  "const": false
                }
              }
            },
            "service": {
              "type": "object",
              "required": [
                "port",
                "annotations"
              ],
              "properties": {
                "port": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                "annotations": {
                  "type": "object"
                }
              }
            },
            "resources": {
              "type": "object",
              "required": [
                "requests",
                "limits"
              ]
            },
            "backendConfig": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "timeoutSec",
                "healthCheck"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
                },
                "timeoutSec": {
                  "type": "integer",
                  "minimum": 1
                },
                "healthCheck": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "requestPath",
                    "port",
                    "checkIntervalSec",
                    "timeoutSec",
                    "healthyThreshold",
                    "unhealthyThreshold"
                  ],
                  "properties": {
                    "requestPath": {
                      "const": "/_healthz"
                    },
                    "port": {
                      "const": 8080
                    },
                    "checkIntervalSec": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "timeoutSec": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "healthyThreshold": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "unhealthyThreshold": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                }
              }
            }
          }
        },
        "publicEntry": {
          "type": "object",
          "required": [
            "enabled",
            "rootAliasHosts",
            "replicaCount",
            "image",
            "serviceAccount",
            "service",
            "backendConfig"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "rootAliasHosts": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^([A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)+[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?$"
              }
            },
            "replicaCount": {
              "type": "integer",
              "minimum": 1
            },
            "image": {
              "type": "object",
              "required": [
                "repository",
                "tag",
                "digest",
                "pullPolicy"
              ],
              "properties": {
                "repository": {
                  "type": "string",
                  "minLength": 1
                },
                "tag": {
                  "type": "string",
                  "minLength": 1,
                  "not": {
                    "pattern": "^(?:latest|stable|main|master)$"
                  }
                },
                "digest": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                },
                "pullPolicy": {
                  "type": "string",
                  "enum": [
                    "Always",
                    "IfNotPresent"
                  ]
                }
              }
            },
            "serviceAccount": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "create",
                "name",
                "automountServiceAccountToken"
              ],
              "properties": {
                "create": {
                  "const": true
                },
                "name": {
                  "const": "versorgungs-kompass-frontend-public"
                },
                "automountServiceAccountToken": {
                  "const": false
                }
              }
            },
            "service": {
              "type": "object",
              "required": [
                "port"
              ],
              "properties": {
                "port": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                }
              }
            },
            "backendConfig": {
              "type": "object",
              "required": [
                "name",
                "timeoutSec",
                "healthCheck",
                "iap"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
                },
                "timeoutSec": {
                  "type": "integer",
                  "minimum": 1
                },
                "healthCheck": {
                  "type": "object",
                  "required": [
                    "requestPath",
                    "port",
                    "checkIntervalSec",
                    "timeoutSec",
                    "healthyThreshold",
                    "unhealthyThreshold"
                  ],
                  "properties": {
                    "requestPath": {
                      "const": "/_healthz"
                    },
                    "port": {
                      "const": 8080
                    },
                    "checkIntervalSec": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "timeoutSec": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "healthyThreshold": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "unhealthyThreshold": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                },
                "iap": {
                  "type": "object",
                  "required": [
                    "enabled",
                    "oauthClientCredentialsSecretName"
                  ],
                  "properties": {
                    "enabled": {
                      "type": "boolean"
                    },
                    "oauthClientCredentialsSecretName": {
                      "type": "string"
                    }
                  },
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "enabled": {
                            "const": true
                          }
                        },
                        "required": [
                          "enabled"
                        ]
                      },
                      "then": {
                        "properties": {
                          "oauthClientCredentialsSecretName": {
                            "minLength": 1
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "authProxy": {
                "properties": {
                  "enabled": {
                    "const": true
                  }
                },
                "required": [
                  "enabled"
                ]
              }
            },
            "required": [
              "authProxy"
            ]
          },
          "then": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            },
            "required": [
              "enabled"
            ]
          },
          "then": {
            "properties": {
              "bucketName": {
                "minLength": 1
              },
              "contentRevision": {
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "publicEntry": {
                "properties": {
                  "enabled": {
                    "const": true
                  }
                },
                "required": [
                  "enabled"
                ]
              }
            },
            "required": [
              "publicEntry"
            ]
          },
          "then": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          }
        }
      ]
    },
    "gke": {
      "type": "object",
      "properties": {
        "managedCertificate": {
          "type": "object",
          "required": [
            "enabled",
            "name",
            "domains",
            "additionalCertificates"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "name": {
              "type": "string",
              "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
            },
            "domains": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^([A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)+[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?$"
              }
            },
            "additionalCertificates": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "domains"
                ],
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
                  },
                  "domains": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "pattern": "^([A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)+[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?$"
                    }
                  }
                }
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "enabled": {
                    "const": true
                  }
                },
                "required": [
                  "enabled"
                ]
              },
              "then": {
                "properties": {
                  "domains": {
                    "minItems": 1
                  }
                }
              }
            }
          ]
        }
      }
    }
  }
}
