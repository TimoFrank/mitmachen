{
	admin off
}

www.{$APP_HOST} {
	log {
		output discard
	}

	header -Server
	redir https://{$APP_HOST}{uri} permanent
}

{$APP_SITE_ADDRESS} {
	log {
		output discard
	}

	encode zstd gzip

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"
	}

	@public-root path /
	handle @public-root {
		root * /srv/public
		rewrite * /public-index.html
		header {
			Cache-Control "no-store"
			Content-Security-Policy "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'none'; connect-src 'none'"
			X-Frame-Options "DENY"
		}
		file_server
	}

	@public-share path /public/media/social/mitmachen-share-v3.png
	handle @public-share {
		root * /srv/public
		header Cache-Control "public, max-age=3600"
		file_server
	}

	handle /oauth2/* {
		reverse_proxy oauth2-proxy:4180 {
			header_up -Authorization
			header_up -X-Auth-Request-Email
			header_up -X-Auth-Request-User
			header_up -X-Auth-Request-Groups
			header_up -X-Auth-Request-Preferred-Username
			header_up -X-Auth-Request-Access-Token
			header_up -X-Forwarded-Email
			header_up -X-Forwarded-User
			header_up -X-Forwarded-Groups
			header_up -X-Forwarded-Preferred-Username
			header_up -X-Forwarded-Access-Token
			header_up -X-Goog-Authenticated-User-Email
			header_up -X-Goog-Authenticated-User-Id
			header_up -X-Goog-Iap-Jwt-Assertion
			header_up X-Real-IP {remote_host}
		}
	}

	handle {
		reverse_proxy oauth2-proxy:4180 {
			header_up -Authorization
			header_up -X-Auth-Request-Email
			header_up -X-Auth-Request-User
			header_up -X-Auth-Request-Groups
			header_up -X-Auth-Request-Preferred-Username
			header_up -X-Auth-Request-Access-Token
			header_up -X-Forwarded-Email
			header_up -X-Forwarded-User
			header_up -X-Forwarded-Groups
			header_up -X-Forwarded-Preferred-Username
			header_up -X-Forwarded-Access-Token
			header_up -X-Goog-Authenticated-User-Email
			header_up -X-Goog-Authenticated-User-Id
			header_up -X-Goog-Iap-Jwt-Assertion
			header_up X-Real-IP {remote_host}
		}
	}
}

:8080 {
	log {
		output discard
	}

	@internal-health path /internal-healthz
	handle @internal-health {
		respond "ok" 200
	}

	@api path /api/*
	handle @api {
		reverse_proxy api:8080 {
			header_up -Cookie
		}
	}

	handle {
		reverse_proxy frontend:8080 {
			header_up -Authorization
			header_up -Cookie
		}
	}
}
